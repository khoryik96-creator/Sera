{
  "name": "quiet-regular-lore",
  "private": true,
  "version": "99.0.0",
  "type": "module",
  "description": "The Quiet Regular — interactive lore repository (Vite + TypeScript).",
  "scripts": {
    "prepare:data": "node scripts/prepare-data.mjs",
    "dev": "npm run prepare:data && vite",
    "build": "npm run prepare:data && tsc --noEmit && vite build",
    "build:single": "npm run prepare:data && tsc --noEmit && vite build --config vite.singlefile.config.ts",
    "preview": "vite preview",
    "typecheck": "npm run prepare:data && tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run prepare:data && vitest run",
    "validate:assets": "node scripts/validate-assets.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "quality": "npm run prepare:data && tsc --noEmit && eslint . && vitest run && node scripts/validate-assets.mjs && npm run audit:prod",
    "budget:perf": "node scripts/check-performance-budget.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0"
  }
}
