{
  "name": "quiet-regular-lore",
  "private": true,
  "version": "99.0.0",
  "type": "module",
  "description": "The Quiet Regular — interactive lore repository (Vite + TypeScript).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --config vite.singlefile.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "validate:assets": "node scripts/validate-assets.mjs",
    "quality": "npm run typecheck && npm run lint && npm run test && npm run validate:assets"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.1.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.0.5"
  }
}
